# Supabase Configuration
# Obtén estas credenciales desde tu proyecto en supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (solo operaciones admin/servidor)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe (obtén las claves en https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# URL de tu sitio en producción (Vercel / dominio propio)
NEXT_PUBLIC_SITE_URL=https://c7dev.vercel.app

# Google AdSense (obtén tu ID en https://www.google.com/adsense)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX