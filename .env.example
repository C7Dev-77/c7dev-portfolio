# .env.example — Variables necesarias para c7dev-portfolio
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore y NUNCA debe subirse a GitHub.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Lemon Squeezy ---
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemonsqueezy-webhook-signing-secret

# --- Work.ink (descarga gratis con anuncio) ---
WORKINK_POSTBACK_SECRET=your-workink-postback-secret

# --- General ---
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5843644780957870
ADMIN_EMAIL=tu-email-admin@ejemplo.com

# --- Upstash Redis (Rate Limiting) ---
UPSTASH_REDIS_REST_URL=https://tu-url-de-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu-token-de-upstash